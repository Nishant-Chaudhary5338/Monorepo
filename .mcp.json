{
  "mcpServers": {
    "ixd-generator": {
      "type": "stdio",
      "command": "node",
      "args": [
        "/Users/nishantchaudhary/Desktop/my-turborepo/tools/ixd-generator/build/ixd-generator/src/index.js"
      ]
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@0.0.29",
        "--storage-state", ".playwright-session.json"
      ]
    },
    "playwright-headless": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@0.0.29",
        "--headless",
        "--storage-state", ".playwright-session.json"
      ]
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest", "--browserUrl", "http://127.0.0.1:9222"]
    },
    "figma": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "cursor-talk-to-figma-mcp@latest"]
    },
    "figma-official": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "handoff-to-figma": {
      "type": "stdio",
      "command": "node",
      "args": [
        "/Users/nishantchaudhary/Desktop/developer/my-turborepo/tools/handoff-to-figma/build/handoff-to-figma/src/index.js"
      ]
    }
  }
}
